# Copia este archivo a `.env.development` (o `.env`) y completa los valores.
# NO commitees secretos reales: `.env*` está ignorado salvo este `.env.example`.

# URL base de la API (incluye sufijo /api/v1)
VITE_API_URL=https://localhost:44332/api/v1

# URL base para imágenes/archivos (opcional; si se omite se deriva de VITE_API_URL)
VITE_IMG_URL_BASE=

# Clave de OpenRouteService (opcional; solo para funcionalidades de mapas/routing)
VITE_ORS_API_KEY=
